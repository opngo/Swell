{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engine/*": ["engine/*"],
      "@swell/schema": ["../../packages/schema/src/index.ts"],
      "@swell/shared": ["../../packages/shared/src/index.ts"],
      "@swell/shaders": ["../../packages/shaders/src/index.ts"],
      "@swell/models": ["../../packages/models/src/index.ts"]
    },
    "types": ["vite/client"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "engine/**/*.ts", "../../packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "electron"]
}
